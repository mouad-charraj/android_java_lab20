<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Number Book"
        android:textColor="#E94560"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnLoadContacts_mouad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charger les contacts du telephone"
        android:backgroundTint="#E94560"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnLoadFromServer_mouad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charger depuis le serveur"
        android:backgroundTint="#1B998B"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSyncContacts_mouad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Synchroniser vers le serveur"
        android:backgroundTint="#0F3460"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etKeyword_mouad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Rechercher par nom ou numero"
        android:textColorHint="#7B7B8E"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E94560"
        android:layout_marginTop="12dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnSearch_mouad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rechercher"
        android:backgroundTint="#533483"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewContacts_mouad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Realise par CHARAJ Mouad aka ZERO-XR7"
        android:textColor="#E94560"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:paddingBottom="4dp" />

</LinearLayout>